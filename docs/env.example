# ============================================================================
# tenants2fast-fastapi — environment template
# All settings use the TENANT_ prefix (pydantic-settings, nested with __).
# It also depends on oauth2fast-fastapi and permissions2fast-fastapi settings.
# ============================================================================

# --- JWT / refresh tokens (oauth2fast-fastapi) -------------------------------
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080
# Set to false ONLY for plain-HTTP dev/staging environments.
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=strict
# Optional Redis cache for refresh tokens (PostgreSQL is the source of truth).
# REDIS_URL=redis://localhost:6379/0

# --- Auth database (pgsqlasync2fast-fastapi) --------------------------------
DB_DEFAULT_CONNECTION=auth
DB_CONNECTIONS__AUTH__USERNAME=auth_user
DB_CONNECTIONS__AUTH__PASSWORD=auth_password
DB_CONNECTIONS__AUTH__HOST=localhost
DB_CONNECTIONS__AUTH__DATABASE=erp_auth
DB_CONNECTIONS__AUTH__PORT=5432
DB_CONNECTIONS__AUTH__IS_SUPERUSER=true

# --- Tenant database base connection ---------------------------------------
DB_CONNECTIONS__TENANT__USERNAME=postgres
DB_CONNECTIONS__TENANT__PASSWORD=postgres
DB_CONNECTIONS__TENANT__HOST=localhost
DB_CONNECTIONS__TENANT__DATABASE=postgres
DB_CONNECTIONS__TENANT__PORT=5432
DB_CONNECTIONS__TENANT__IS_SUPERUSER=true

# --- tenants2fast-fastapi ---------------------------------------------------
TENANT_DB_PREFIX=tenant_
TENANT_URL_PREFIX=tenants
TENANT_BASE_DB_CONNECTION=tenant
TENANT_MAX_TENANT_CONNECTIONS=5
TENANT_REDIS_URL=redis://localhost:6379/0
TENANT_REDIS_TTL=300
TENANT_SEED_PROFILE=dev

# --- permissions2fast-fastapi (optional Redis RBAC cache) -------------------
PERMISSIONS_REDIS_RBAC_ENABLED=true
PERMISSIONS_REDIS__HOST=localhost
PERMISSIONS_REDIS__PORT=6379
PERMISSIONS_REDIS__DB=0
# PERMISSIONS_REDIS__PASSWORD=your_redis_password
